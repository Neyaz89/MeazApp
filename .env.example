# Supabase Configuration (Required)
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Supabase Service Role (Required for admin operations)  
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# Agora Configuration (Required for video calls)
EXPO_PUBLIC_AGORA_APP_ID=your_agora_app_id_here
EXPO_PUBLIC_AGORA_APP_CERTIFICATE=your_agora_app_certificate_here

# Optional: Analytics & Services
EXPO_PUBLIC_ANALYTICS_KEY=your_analytics_key_here
EXPO_PUBLIC_SENTRY_DSN=your_sentry_dsn_here

# Environment
NODE_ENV=development

# App Configuration
EXPO_PUBLIC_APP_NAME="Meaz Mobile"
EXPO_PUBLIC_APP_VERSION=1.0.0